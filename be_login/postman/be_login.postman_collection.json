{
  "info": {
    "name": "be_login API",
    "description": "Postman requests for the Express authentication API. Postman keeps the access_token HttpOnly cookie automatically after login; use the same host for authenticated requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API root",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/",
        "description": "API information endpoint."
      }
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "description": "Checks both API and MySQL connectivity."
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"ChangeMe123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Creates a user with role=user. Password must be at least 12 characters. displayName is currently derived from the email prefix."
          }
        },
        {
          "name": "Login (remember me)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@rich.demo\",\n  \"password\": \"Demo123!\",\n  \"rememberMe\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Returns user and expiry info; JWT is set in the access_token HttpOnly cookie. rememberMe=true defaults to 30 days; false defaults to 8 hours."
          }
        },
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@rich.demo\",\n  \"password\": \"Demo123!\",\n  \"rememberMe\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Logs in using the seeded admin account; Postman stores the access_token cookie automatically."
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me",
            "description": "Requires the access_token cookie saved by Postman after login."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/logout",
            "description": "Revokes the current database session and clears the cookie. Expected success: 204 No Content."
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List recent sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/sessions",
            "description": "Requires login as admin@rich.demo or another admin account."
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" }
  ]
}
