{
  "info": {
    "name": "be_login API",
    "description": "Postman requests for the Express authentication API. The collection saves accessToken for Bearer requests and retains the HttpOnly refresh cookie.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "event": [{
    "listen": "test",
    "script": {
      "type": "text/javascript",
      "exec": [
        "if (pm.request.url.toString().includes('/auth/login') || pm.request.url.toString().includes('/auth/refresh')) {",
        "  const body = pm.response.json();",
        "  if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
        "}"
      ]
    }
  }],
  "item": [
    {
      "name": "API root",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/",
        "description": "API information endpoint."
      }
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "description": "Checks both API and MySQL connectivity."
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"ChangeMe123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Creates a user with role=user. Password must be at least 12 characters. displayName is currently derived from the email prefix."
          }
        },
        {
          "name": "Login (remember me)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@rich.demo\",\n  \"password\": \"Demo123!\",\n  \"rememberMe\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login",
          "description": "Returns user, accessToken, accessExpiresAt, and sessionExpiresAt. Keep accessToken in client memory and send as Bearer. rememberMe=true also sets a refresh_token HttpOnly cookie; false issues no refresh token."
          }
        },
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@rich.demo\",\n  \"password\": \"Demo123!\",\n  \"rememberMe\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Logs in using the seeded admin account; the collection stores accessToken for Bearer requests, while Postman retains the HttpOnly refresh cookie."
          }
        },
        {
          "name": "Refresh access token",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/refresh",
            "description": "Send after login with rememberMe=true. Postman sends the HttpOnly refresh_token cookie and stores the rotated cookie from the response. Reuse of an older token revokes the session."
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me",
            "description": "Requires the Bearer accessToken saved by the collection after login."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/logout",
            "description": "Revokes the current database session using Bearer accessToken or the refresh cookie. Expected success: 204 No Content."
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List recent sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/sessions",
            "description": "Requires login as admin@rich.demo or another admin account."
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4200/api" }
  ]
}
