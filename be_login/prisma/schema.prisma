generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

model User {
  id           String    @id @default(uuid()) @db.Char(36)
  email        String    @unique @db.VarChar(254)
  displayName  String    @map("display_name") @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         Role      @default(user)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  disabledAt   DateTime? @map("disabled_at") @db.DateTime(3)
  sessions     Session[]

  @@map("users")
}

model Session {
  id            String         @id @default(uuid()) @db.Char(36)
  userId        String         @map("user_id") @db.Char(36)
  rememberMe    Boolean        @default(false) @map("remember_me")
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt     DateTime       @map("expires_at") @db.DateTime(3)
  revokedAt     DateTime?      @map("revoked_at") @db.DateTime(3)
  ipAddress     String?        @map("ip_address") @db.VarChar(45)
  userAgent     String?        @map("user_agent") @db.VarChar(512)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id           String        @id @default(uuid()) @db.Char(36)
  sessionId    String        @map("session_id") @db.Char(36)
  tokenHash    String        @unique @map("token_hash") @db.Char(64)
  createdAt    DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt    DateTime      @map("expires_at") @db.DateTime(3)
  usedAt       DateTime?     @map("used_at") @db.DateTime(3)
  replacedById String?       @unique @map("replaced_by_id") @db.Char(36)
  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy   RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replacedFrom RefreshToken? @relation("RefreshTokenRotation")

  @@index([sessionId, expiresAt])
  @@map("refresh_tokens")
}
