PORT=8000
DATABASE_URL='mysql://root:your_mysql_password@localhost:3306/be_login'
JWT_SECRET=replace-with-at-least-32-random-bytes
#Access token: 60 วินาที
ACCESS_TTL_SECONDS=60
#Remember Me session สูงสุด: 90 วินาที
REMEMBER_ME_TTL_SECONDS=90
# Refresh token: 20 วินาที
REFRESH_TOKEN_TTL_SECONDS=20 
COOKIE_SECURE=false
REFRESH_COOKIE_PATH=/api/auth
